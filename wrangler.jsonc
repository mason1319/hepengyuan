{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hepengyuan-personal-site",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-07",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "hepengyuan.com/*",
      "zone_name": "hepengyuan.com"
    },
    {
      "pattern": "www.hepengyuan.com/*",
      "zone_name": "hepengyuan.com"
    }
  ],
  "triggers": {
    "crons": ["*/10 * * * *"]
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/admin",
      "/admin/*",
      "/api/*",
      "/media/file/*",
      "/media/poster/*",
      "/travel",
      "/travel/*",
      "/learning",
      "/learning/*",
      "/stories/*",
      "/sitemap-media.xml"
      ,"/blog",
      "/blog/*",
      "/sitemap-blog.xml"
    ]
  },
  "d1_databases": [
    {
      "binding": "MEDIA_DB",
      "database_name": "hepengyuan-media",
      "database_id": "99a911f4-3626-4784-b0f4-129e7238b5ea",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "hepengyuan-media"
    }
  ],
  "vars": {
    "PUBLIC_SITE_URL": "https://hepengyuan.com",
    "CF_ACCESS_ISSUER": "https://green-wave-2b0b.cloudflareaccess.com",
    "CF_ACCESS_AUD": "6c472d5dca6caba01813c252e51ef8ddadb600b77f8686d4094c0f5e9cb99675",
    "ADMIN_EMAILS": "653091hepeng@gmail.com"
  },
  "observability": {
    "enabled": true
  }
}
